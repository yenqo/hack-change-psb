# Переменные ядра. Значения ключей не коммитить: копию с ключами храните в .env (он в .gitignore).
# На платформе их задаёт сама платформа; локально и для веб-части — из окружения или .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=
RERANKER_MODEL=
EMBEDDER_API_KEY=
RERANKER_API_KEY=
TEMPERATURE=
MAX_TOKENS=
MAX_WORKERS=
DATA_DIR=

# Отладка ядра (локально)
SOLUTION_DEBUG=
SOLUTION_PROBE=
SOLUTION_PROBE_RERANK=
SOLUTION_PREBUILT_INDEX=

# Доработки за флагами, ждут замера на golden set (по умолчанию выключены)
SOLUTION_FEWSHOT=
SOLUTION_FIX_DOCNUM=
SOLUTION_CHECK_REFS=
SOLUTION_CONCISE=
SOLUTION_SOFT_DEGRADE=
SOLUTION_RERANK_RECHECK=
SOLUTION_LEVEL_FORECAST=
SOLUTION_FINAL_PASS=

# Веб-интерфейс (web/server.py, compose.yaml); подробно — web/README.md
# EMB_BASE_URL в Docker задаёт compose (http://emb:8080/v1); локально — адрес своего llama-server, например http://127.0.0.1:8081/v1
EMB_BASE_URL=
EMB_WAIT_SECONDS=
RERANK_BASE_URL=
WEB_ANSWER_TIMEOUT=
# Порт на хосте для docker compose (по умолчанию 8000; на сервере — 80)
WEB_HOST_PORT=

# Только для разработки (tools/dev_proxy.py): закрепить хостера модели у агрегатора, локальные эмбеддинги
DEV_EXTRA_BODY=
DEV_EMB_URL=
DEV_EMB_MODEL=
