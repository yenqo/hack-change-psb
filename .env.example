# Переменные ядра. Значения ключей не коммитить: копию с ключами храните в .env (он в .gitignore).
# На платформе их задаёт сама платформа; локально и для веб-части — из окружения или .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=
RERANKER_MODEL=
EMBEDDER_API_KEY=
RERANKER_API_KEY=
TEMPERATURE=
MAX_TOKENS=
MAX_WORKERS=
DATA_DIR=

# Отладка и служебное (локально; на платформе не задаются)
SOLUTION_DEBUG=
SOLUTION_PROBE=
SOLUTION_PROBE_RERANK=
SOLUTION_TODAY=
SOLUTION_TIME_BUDGET=
SOLUTION_MODE=
SOLUTION_INDEX_FILE=

# Флаги доработок (пусто — значение по умолчанию; описание и статус — в README, «Флаги доработок»)
# включены по умолчанию (0 — выключить)
SOLUTION_PREBUILT_INDEX=
SOLUTION_SOFT_DEGRADE=
SOLUTION_RERANK_RECHECK=
SOLUTION_LEVEL_FORECAST=
SOLUTION_FINAL_PASS=
SOLUTION_CONCISE=
SOLUTION_ANSWER_TEMPLATE=
SOLUTION_REWRITE=
SOLUTION_REWRITE_PROMPT=
SOLUTION_GENERAL_POINTS=
SOLUTION_CHECK_FIXES=
SOLUTION_SOURCE_RULE=
# fictional (по умолчанию) или demo
SOLUTION_FEWSHOT=
# выключены по умолчанию (1 — включить)
SOLUTION_FIX_DOCNUM=
SOLUTION_CHECK_REFS=
SOLUTION_CHUNK_FIXES=
SOLUTION_DATE_CONDITIONS=
SOLUTION_CROSS_REFS=

# Веб-интерфейс (web/server.py, compose.yaml); подробно — web/README.md
# EMB_BASE_URL в Docker задаёт compose (http://emb:8080/v1); локально — адрес своего llama-server, например http://127.0.0.1:8081/v1
EMB_BASE_URL=
EMB_WAIT_SECONDS=
RERANK_BASE_URL=
WEB_ANSWER_TIMEOUT=
# Порт на хосте для docker compose (по умолчанию 8000; на сервере — 80)
WEB_HOST_PORT=

# Только для разработки (tools/dev_proxy.py): закрепить хостера модели у агрегатора, локальные эмбеддинги
DEV_EXTRA_BODY=
DEV_EMB_URL=
DEV_EMB_MODEL=
