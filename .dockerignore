# В образ попадает только то, что перечислено в Dockerfile; здесь — то, что точно не нужно в контексте сборки.
.git
.venv
.claude
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.DS_Store

# Разработка ядра: тесты, инструменты, оценка, документация, архивы сабмитов
tests
tools
eval
docs
dist

# Фронт: зависимости и сборка ставятся заново внутри образа
web/frontend/node_modules
web/frontend/dist

# Распакованная копия базы (в образ идёт knowledge-base.zip)
data/knowledge-base

# Сохранённая страница сайта ПСБ (только для референса стиля)
ПСБ*
